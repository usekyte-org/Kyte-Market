# 31337 = local devnet (anvil on :8547), 46630 = Robinhood Chain testnet, 4663 = mainnet
NEXT_PUBLIC_CHAIN_ID=4663
# Optional RPC override (defaults: local :8547 / official Robinhood RPCs)
NEXT_PUBLIC_RPC_URL=
# 1 = show demo data instead of reading the chain
NEXT_PUBLIC_DEMO=0
# Indexer API (indexer/, run with the same CHAIN_ID, e.g. https://api.kyte.sh). Leave empty to read the chain directly from the browser.
NEXT_PUBLIC_INDEXER_URL=
# Privy app id (wallet picker, installed wallets only). Add http://localhost:3010 to the app's allowed origins in the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=
# Public URL, used for Open Graph images
NEXT_PUBLIC_SITE_URL=http://localhost:3010
# Kyte agent (/api/agent, server only). Set ONE of the keys; leave both empty to disable the agent.
#   ANTHROPIC_API_KEY  -> Anthropic API directly, AGENT_MODEL like claude-sonnet-5-5
#   AI_GATEWAY_API_KEY -> Vercel AI Gateway (Anthropic-compatible), AGENT_MODEL like anthropic/claude-sonnet-5.5
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
AGENT_MODEL=
AGENT_DAILY_LIMIT=30

# MCP connector endpoint and /mcp page. Production sets false until launch; leave unset locally.
NEXT_PUBLIC_MCP_ENABLED=true

# Autopilot page, nav, agent tools. Production sets false until launch; leave unset locally.
NEXT_PUBLIC_AUTOPILOT_ENABLED=true

# Launchpad page, nav, list_graduated tool. Production sets false until launch; leave unset locally.
NEXT_PUBLIC_LAUNCHPAD_ENABLED=true
